{
  "appId": "com.navodita.pulse",
  "appName": "Pulse Chat",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "pulsechatmessenger.vercel.app",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#09090b"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#00000000",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_pulse",
      "iconColor": "#00E5FF"
    }
  }
}

